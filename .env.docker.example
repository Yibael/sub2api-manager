# Public browser origin, without a path or trailing slash. HTTPS is required.
APP_ORIGIN=https://manager.example.com

# sub2api URL and server-side Admin API Key.
SUB2API_URL=https://sub2api.example.com
SUB2API_ADMIN_KEY=''
# Separate application access password; at least 16 characters.
APP_PASSWORD=''

INSTANCE_NAME=我的工作空间
# Must match the upstream daily-statistics timezone.
SUB2API_TIMEZONE=Asia/Shanghai
ALLOW_HTTP_UPSTREAM=false

# Host loopback port for your HTTPS reverse proxy. Container port stays 3001.
APP_PORT=3001
SUB2API_MANAGER_IMAGE=sub2api-manager:local
# Keep this aligned with package.json's packageManager when upgrading Bun.
BUN_VERSION=1.3.9
