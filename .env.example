# Final HTTPS address of your sub2api instance (subpaths supported).
SUB2API_URL=https://sub2api.example.com
SUB2API_ADMIN_KEY=
# A separate application password, at least 16 characters. Never use VITE_ for secrets.
APP_PASSWORD=
# Exact browser origin; for development use http://localhost:5173.
APP_ORIGIN=http://localhost:5173
INSTANCE_NAME=我的工作空间
# Must match sub2api's daily-statistics timezone; used to invalidate today's cache.
SUB2API_TIMEZONE=Asia/Shanghai
PORT=3001
HOST=127.0.0.1
DATA_DIR=.data
ALLOW_HTTP_UPSTREAM=false
