# 浏览器访问地址，不带路径或末尾斜杠；生产环境必须使用 HTTPS。
# 本地开发可在启动时覆盖：APP_ORIGIN=http://localhost:5173 bun run dev
APP_ORIGIN=https://manager.example.com

# sub2api 地址（支持子路径）与服务端 Admin API Key。
SUB2API_URL=https://sub2api.example.com
# 密钥或密码含 $ 时写成 \$，并保留双引号，兼容 Bun 和 Compose。
SUB2API_ADMIN_KEY=""
# 应用独立访问密码，至少 16 个字符。
APP_PASSWORD=""

INSTANCE_NAME=我的工作空间
# 必须与上游今日统计的时区一致。
SUB2API_TIMEZONE=Asia/Shanghai
ALLOW_HTTP_UPSTREAM=false

# 本地 API 端口 / Docker 宿主机端口；容器内部固定使用 3001。
PORT=3001
