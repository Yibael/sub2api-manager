{
  "name": "sub2api-manager",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"bun --watch server/index.ts\" \"vite\"",
    "dev:server": "bun --watch server/index.ts",
    "build": "bun run typecheck && vite build",
    "build:server": "bun build --target=bun --env=disable --outfile=build/server.js server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "preview": "vite preview",
    "icons": "bun scripts/icons.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run && bun test tests/sqlite.bun.test.ts",
    "lint": "oxlint src server shared tests"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/static": "^1.4.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "decimal.js": "^10.6.0",
    "elysia": "^1.4.30",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.3.9"
}
